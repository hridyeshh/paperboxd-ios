<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links for paperboxd.in/fusion/*. Needs a paid team; a personal
	     team cannot sign this, so Debug uses the empty PaperBoxd.entitlements and
	     relies on the paperboxd:// scheme instead. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:paperboxd.in</string>
	</array>
</dict>
</plist>
